# Copy to .env to override defaults used by docker-compose.yml.
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_pwd
POSTGRES_PORT=5432

KAFKA_VERSION=4.3.1
KAFKA_PORT=9092
KAFKA_TOPIC=products
KAFKA_DLQ_TOPIC=products.dlq

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root_pwd
MONGO_DATABASE=product_catalog
MONGO_APP_USERNAME=sync_app
MONGO_APP_PASSWORD=sync_app_pwd
MONGO_PORT=27017

PRODUCER_POLL_INTERVAL_SECONDS=2
LOG_LEVEL=INFO

KAFKA_UI_PORT=8080
MONGO_EXPRESS_PORT=8081
ADMINER_PORT=8082
